# ============================================================================
# OmniFlow — LOCAL backend configuration (committed; safe values only).
#
# Points the app at a `supabase start` stack on localhost. To use a hosted
# Supabase project instead, create .env.local (gitignored) with the same
# VITE_ variables pointing at your cloud project.
#
# The frontend reads these via Vite (VITE_* -> import.meta.env):
#   VITE_SUPABASE_URL       base URL of the Supabase-compatible API
#   VITE_SUPABASE_ANON_KEY  public anon key (JWTs are validated server-side;
#                           RLS still scopes every row to auth.uid())
#   VITE_SUPABASE_REST_URL  optional PostgREST base override when auth and
#                           REST live on different origins (cloud: omit)
# ============================================================================

# Local stack: auth on :54321/auth/v1, PostgREST on :54321/rest/v1.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
